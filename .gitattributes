* text=auto eol=lf
*.cs text diff=csharp
*.fs text diff=fsharp
*.sln text eol=crlf
*.slnx text eol=lf
*.csproj text eol=lf
*.fsproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.snk binary
*.png binary
*.ico binary

# Formatter fixtures are byte-exact golden files: never normalise them.
*.test -text
*.verified.* -text

# Generated from OptionDescriptor.All by running Curb with end_of_line = crlf, so its crlf example is
# real \r\n bytes — the one page in docs/reference the blanket `*.md text eol=lf` above would otherwise
# silently launder back to LF on every commit, making the crlf example demonstrate nothing.
docs/reference/core/end_of_line.md -text
