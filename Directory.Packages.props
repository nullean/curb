<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime dependencies.

         Microsoft.CodeAnalysis.CSharp is EXACT-pinned on purpose: Roslyn version bumps change parse
         trees for new language features and therefore change formatting output. Treat a bump as a
         behaviour change requiring a corpus diff review, not a routine dependency update.

         Validated 5.6.0 under native AOT: links, 10.7 MB binary, ~27 MB/s parse.

         5.6.0 is also head-of-published: nuget has nothing newer. The compiler inside the SDK is a
         different thing and is always ahead — SDK 10.0.400 carries 5.900.26.38015, which is not on nuget
         and structurally never will be. Matching it is deliberately not attempted; see docs/cleanup.md
         for why that rules out hosting the SDK's own code style analysers. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.6.0]" />
    <!-- 0.18.0 fixes a static, process-wide cache collision (editorconfig/editorconfig-core-net#64,
         found while diagnosing nullean/curb#65): EditorConfigFileCache is now private per
         EditorConfigParser instance by default, so CurbEditorConfig no longer needs its own
         workaround cache — see CurbEditorConfig.cs. -->
    <PackageVersion Include="editorconfig" Version="0.18.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
    <!-- 0.18.0 fixes handler exit codes (nullean/argh#65), an illink crash under TreatWarningsAsErrors
         (nullean/argh#67), and drops a ~1 MB System.Text.Json dependency (nullean/argh#66). Reference
         Nullean.Argh, not Nullean.Argh.Hosting — see Nullean.Curb.Cli.csproj. -->
    <PackageVersion Include="Nullean.Argh" Version="0.18.0" />

    <!-- Fingerprints the file content and the resolved options behind the `cache` flag. XxHash128 rather
         than SHA-256 out of System.Security.Cryptography, and the reason is native AOT rather than speed:
         on Linux the crypto stack goes through the OpenSSL shim, so hashing would hand a binary that has
         no native dependency today a libssl/libcrypto one, and throw per file on a host without it. This
         package is pure managed and ships no native assets; measured on osx-arm64, it costs the AOT
         binary 65 KB, 13,581,712 bytes to 13,648,288. The speed difference decided nothing — about 3 ms
         across the 6.5 MB corpus, against a ~300 ms parse floor.

         Collision resistance is not a requirement here. Anyone able to write the cache file can write the
         .cs file next to it, so there is no adversary a cryptographic digest would keep out. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="TUnit" Version="1.65.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- Formatting tests carry their expected output inline as raw strings, so a readable diff on
         failure matters more than a snapshot library. Verify was referenced and never used. -->
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build script dependencies -->
    <PackageVersion Include="Argu" Version="6.2.5" />
    <PackageVersion Include="Bullseye" Version="6.1.0" />
    <PackageVersion Include="Proc" Version="0.14.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="6.1.4" />
  </ItemGroup>
</Project>
