<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Nullean.Curb.EditorConfig</RootNamespace>
    <Description>Binds .editorconfig files to Curb formatting options, including the full IDE0055 csharp_* and dotnet_* surface.</Description>
    <PackageTags>csharp;formatter;editorconfig;ide0055;code-style</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Nullean.Curb.Core/Nullean.Curb.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="editorconfig" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullean.Curb.Tests" PublicKey="" />
  </ItemGroup>

</Project>
