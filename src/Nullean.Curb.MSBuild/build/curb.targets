<Project>

  <!--
    Curb runs before the compiler, not after it.

    The point of this ordering is EnforceCodeStyleInBuild. With that property set, the IDE analysers
    run inside CoreCompile and report IDE0055 and the code style rules as build diagnostics. A target
    at BeforeTargets="CoreCompile" has already rewritten the files by then, so the compiler reads
    formatted source and the only style diagnostics left are the ones that genuinely need a
    compilation to decide. Someone — or something — building the project gets the mechanical
    offences fixed underneath them and only has to think about the semantic remainder.

    Running after the build, or as a separate command someone has to remember, would not do that.
  -->

  <PropertyGroup>
    <!-- Check rather than rewrite. Defaults to rewriting in Debug and checking in Release: a
         developer wants their file fixed, and a release or CI build wants to be told, not edited. -->
    <Curb_Check Condition="'$(Curb_Check)' == '' and '$(Configuration)' == 'Release'">true</Curb_Check>
    <Curb_Check Condition="'$(Curb_Check)' == ''">false</Curb_Check>

    <!-- The escape hatch. One property, honoured everywhere, so a build that must not be touched
         has a single thing to set. -->
    <Curb_Bypass Condition="'$(Curb_Bypass)' == ''">false</Curb_Bypass>

    <!-- Report unformatted files as warnings rather than errors. Off, because a check that does not
         fail the build is a check nobody notices. -->
    <Curb_UnformattedAsWarnings Condition="'$(Curb_UnformattedAsWarnings)' == ''">false</Curb_UnformattedAsWarnings>

    <!-- Reuse the previous run's verdict for files that have not changed. On, because the cost of being
         wrong is one cold run and the cost of being right is most of a build step. A boolean rather than
         emptying Curb_CacheFile, because a property set to nothing is indistinguishable from one nobody
         set, so the condition that defaults the path would simply put it back. -->
    <Curb_Cache Condition="'$(Curb_Cache)' == ''">true</Curb_Cache>

    <!-- MSBuild message importance for Curb's own output: high, normal or low. Low by default, so
         a successful format is invisible at normal verbosity and the one-line summary is there when
         someone asks for it. Errors and warnings are raised as diagnostics regardless. -->
    <Curb_LogLevel Condition="'$(Curb_LogLevel)' == ''">low</Curb_LogLevel>

  </PropertyGroup>

  <Target Name="CurbDiagnostics" BeforeTargets="CoreCompile" Condition="'$(Curb_Diagnostics)' != 'false'">
    <!--
      Ask the compiler to write down what it reported, so `curb cleanup` can fix the semantic rules Curb
      cannot decide from syntax. This is the whole of cleanup's involvement in a build: no target that
      rewrites anything, no Exec, nothing that runs after the compiler. A code clean tool does not own
      building — someone runs `dotnet build`, and if style diagnostics come back they run `curb cleanup`.

      Why the log and not the console output: MSBuild reports a diagnostic's start but not its end, and
      IDE0005 is one diagnostic per contiguous run of unnecessary using directives. Measured, on five
      directives where the third was needed: the log gave two results spanning lines 1-2 and 4-5. From
      start positions alone the run's extent is not recoverable — one unused directive, then a needed
      one, then an unused one reports two starts, while two unused then a needed one reports a single
      start — so a console-driven fix would delete a directive something needs.

      Set here rather than in the PropertyGroup at the top of this file, because $(ErrorLog) and
      $(IntermediateOutputPath) are not set until the SDK's own targets have been imported.
    -->
    <PropertyGroup Condition="'$(ErrorLog)' == '' and '$(TargetFramework)' != '' and '$(Curb_Bypass)' != 'true'">
      <!--
        Only when the project has not set one. A consumer's own error log feeds their own tooling, and
        fighting over a single-valued property would break it.

        $(TargetFramework) has to be non-empty so the outer build of a multi-targeting project does not
        set a path both inner builds then write to. Measured: they do not coordinate, and the result is
        two SARIF documents concatenated into one file that no JSON reader will accept.
        $(IntermediateOutputPath) is already per target framework, which is why it is the right place.
      -->
      <ErrorLog>$(IntermediateOutputPath)curb.sarif,version=2.1</ErrorLog>
      <Curb_WroteDiagnostics>true</Curb_WroteDiagnostics>
    </PropertyGroup>

    <!-- So `dotnet clean` takes it away again. Only the log this target asked for, never a consumer's. -->
    <ItemGroup Condition="'$(Curb_WroteDiagnostics)' == 'true'">
      <FileWrites Include="$(IntermediateOutputPath)curb.sarif" />
    </ItemGroup>
  </Target>

  <Target Name="CurbPrepare">
    <!--
      Both of these are resolved here rather than in the PropertyGroup above, because that is
      evaluated when this file is imported and $(IntermediateOutputPath) is not set until the SDK's
      own targets have been. Setting the stamp path up there left `curb.stamp` and `curb.files` in
      the project directory next to somebody's source — which a build tool has no business doing, and
      which was invisible until one of them was committed.

      A target's Inputs and Outputs are evaluated after its DependsOnTargets have run, so setting the
      stamp path here is early enough for incrementality to use it.
    -->
    <PropertyGroup>
      <Curb_StampFile Condition="'$(Curb_StampFile)' == ''">$(IntermediateOutputPath)curb.stamp</Curb_StampFile>
      <Curb_FileList Condition="'$(Curb_FileList)' == ''">$(IntermediateOutputPath)curb.files</Curb_FileList>

      <!-- Where `check` writes back the paths that would change, so the CURB0001 diagnostic below can
           be attached to each of them instead of to the project. Only `check` ever writes it; `format`
           leaves nothing unformatted to list. -->
      <Curb_UnformattedFile Condition="'$(Curb_UnformattedFile)' == ''">$(IntermediateOutputPath)curb.unformatted</Curb_UnformattedFile>

      <!-- Per file rather than per project; see the note in the Curb target for what that buys. Here for
           the same reason as the other two, and per target framework for the same reason as the error
           log, so two inner builds of a multi-targeting project cannot write over each other. Set
           Curb_Cache to false to build without one. -->
      <Curb_CacheFile Condition="'$(Curb_CacheFile)' == ''">$(IntermediateOutputPath)curb.cache</Curb_CacheFile>

      <!-- The framework-dependent build that ships in this package, run on the SDK doing the build.
           See the package project for why this is not a per-RID native binary. Curb_Exe overrides it
           with a native one, which starts in about a hundredth of the time. -->
      <Curb_Dll Condition="'$(Curb_Dll)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/curb.dll</Curb_Dll>
    </PropertyGroup>
  </Target>

  <Target Name="Curb"
          BeforeTargets="CoreCompile"
          DependsOnTargets="CurbPrepare"
          Inputs="@(Compile);@(EditorConfigFiles);$(MSBuildProjectFullPath)"
          Outputs="$(Curb_StampFile)"
          Condition="'$(Curb_Bypass)' != 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'
                     and '$(Language)' == 'C#'
                     and '@(Compile)' != ''">

    <!--
      $(Language) rather than the project extension, because a shared Directory.Build.props is what
      the docs recommend for a solution — putting the package reference in one place — and that
      reaches every project underneath it whatever it builds. @(Compile) is real source paths in an
      .fsproj too, not an empty group, so without this an F# project's own files would be handed to a
      C# parser and reported as files that do not parse.
    -->

    <!--
      Two layers of incrementality, and the order between them is the point.

      First, this target's Inputs and Outputs against the compile set and the .editorconfig files that
      govern it. An untouched project pays nothing at all: no process start, no directory walk, no file
      reads. That is still the layer that matters most, because the cheapest run is the one that does
      not happen, and no cache can beat not being consulted.

      Second, Curb_CacheFile, for the runs that do happen. Incrementality here is per project, so one
      edited file out of eight hundred re-runs the target over all eight hundred, and without a cache it
      re-parses the seven hundred and ninety-nine only to conclude they were already formatted. The
      cache records, per file, that Curb ran the formatter over exactly those bytes under exactly those
      resolved options and got them back unchanged, so the re-run costs the file that moved. It earns
      the most under Curb_Check=true: a failing check never stamps, so the target repeats on every
      build until someone formats the file.

      It is a build artefact and is named as one. It sits in $(IntermediateOutputPath) beside the stamp
      and the file list, and it is in FileWrites, so `dotnet clean` takes it away. Curb has no ambient
      cache under a user profile directory — one nobody named is one nobody can find, clear or reason
      about, and it outlives every repository that fed it.

      The project file is an input because changing it can change which files are compiled.
    -->

    <PropertyGroup>
      <_CurbCommand>format</_CurbCommand>
      <_CurbCommand Condition="'$(Curb_Check)' == 'true'">check</_CurbCommand>
    </PropertyGroup>

    <!-- Only the files this project actually compiles. Passing the folder would reach sources that
         belong to another project, or to none. -->
    <WriteLinesToFile File="$(Curb_FileList)"
                      Lines="@(Compile->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <PropertyGroup>
      <_CurbInvocation Condition="'$(Curb_Exe)' != ''">&quot;$(Curb_Exe)&quot;</_CurbInvocation>
      <_CurbInvocation Condition="'$(Curb_Exe)' == ''">&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(Curb_Dll)&quot;</_CurbInvocation>
      <_CurbCacheArg Condition="'$(Curb_Cache)' != 'false' and '$(Curb_CacheFile)' != ''">--cache &quot;$(Curb_CacheFile)&quot;</_CurbCacheArg>

      <!-- Only `check` reads this back; a `format` run leaves nothing unformatted to name. -->
      <_CurbUnformattedArg Condition="'$(_CurbCommand)' == 'check'">--unformatted-list-file &quot;$(Curb_UnformattedFile)&quot;</_CurbUnformattedArg>
    </PropertyGroup>

    <Exec Command="$(_CurbInvocation) $(_CurbCommand) --msbuild-list-file &quot;$(Curb_FileList)&quot; $(_CurbCacheArg) $(_CurbUnformattedArg)"
          StandardOutputImportance="$(Curb_LogLevel)"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_CurbExitCode" />
    </Exec>

    <!-- The file `check` wrote back, one unformatted path per line, so each diagnostic below lands on
         the source file that actually needs reformatting instead of on this project — that is what a
         GitHub Actions annotation anchors to, and $(MSBuildProjectFullPath) with no line number was
         never actionable from the PR checks panel alone. -->
    <ReadLinesFromFile File="$(Curb_UnformattedFile)" Condition="'$(_CurbExitCode)' == '1' and Exists('$(Curb_UnformattedFile)')">
      <Output TaskParameter="Lines" ItemName="_CurbUnformattedFiles" />
    </ReadLinesFromFile>

    <!-- Exit 1 is "some files are not formatted", which only `check` can produce. Anything else
         non-zero is Curb failing, and that is an error whatever the warnings setting says: a
         formatter that could not run has verified nothing, and saying so quietly would be worse
         than not running at all.

         Batches once per file: MSBuild runs a task once per distinct value of item metadata referenced
         in its parameters, and %(_CurbUnformattedFiles.Identity) is exactly that. -->
    <Warning Condition="'$(_CurbExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' == 'true' and '@(_CurbUnformattedFiles)' != ''"
             Code="CURB0001"
             File="%(_CurbUnformattedFiles.Identity)"
             Text="This file is not formatted. Run 'curb format'." />

    <Error Condition="'$(_CurbExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' != 'true' and '@(_CurbUnformattedFiles)' != ''"
           Code="CURB0001"
           File="%(_CurbUnformattedFiles.Identity)"
           Text="This file is not formatted. Run 'curb format'." />

    <!-- Fallback for a check that reported failure without naming a file, e.g. an older curb.dll
         (built before the unformatted-list-file flag existed) supplied through $(Curb_Exe). -->
    <Warning Condition="'$(_CurbExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' == 'true' and '@(_CurbUnformattedFiles)' == ''"
             Code="CURB0001"
             Text="Some files are not formatted. Run 'curb format', or build without Curb_Check=true." />

    <Error Condition="'$(_CurbExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' != 'true' and '@(_CurbUnformattedFiles)' == ''"
           Code="CURB0001"
           Text="Some files are not formatted. Run 'curb format', or build without Curb_Check=true." />

    <Error Condition="'$(_CurbExitCode)' != '0' and '$(_CurbExitCode)' != '1'"
           Code="CURB0002"
           Text="Curb failed with exit code $(_CurbExitCode)." />

    <!-- Only stamp a clean run. Stamping after a failure would make the next build skip the target
         and look like it passed. -->
    <Touch Condition="'$(_CurbExitCode)' == '0'" Files="$(Curb_StampFile)" AlwaysCreate="true" />

    <ItemGroup>
      <FileWrites Include="$(Curb_StampFile);$(Curb_FileList);$(Curb_CacheFile);$(Curb_UnformattedFile)" />
    </ItemGroup>
  </Target>

  <!--
    F#, through Fantomas. A target of its own rather than a branch of the one above, so the C# target stays
    exactly as it was, and so an F# project's options are never confused with a C# one's.

    Curb formats F# only where a local tool manifest declares Fantomas (`dotnet tool install fantomas`), and
    never installs it. Without one the run declines the files with one line and succeeds, so adding the
    package to a mixed solution through a shared Directory.Build.props changes nothing for F# until someone
    pins Fantomas. With one that is not restored the build fails with CURB0002, saying to run
    `dotnet tool restore`.

    Set Curb_FSharp to false to leave F# projects alone while keeping the C# target.
  -->
  <Target Name="_CurbFSharpPrepare" DependsOnTargets="CurbPrepare">
    <PropertyGroup>
      <Curb_FSharpStampFile Condition="'$(Curb_FSharpStampFile)' == ''">$(IntermediateOutputPath)curb.fsharp.stamp</Curb_FSharpStampFile>
      <Curb_FSharpFileList Condition="'$(Curb_FSharpFileList)' == ''">$(IntermediateOutputPath)curb.fsharp.files</Curb_FSharpFileList>
      <_CurbFSharpIntermediate>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)'))</_CurbFSharpIntermediate>
    </PropertyGroup>

    <ItemGroup>
      <!-- The SDK compiles generated files from obj/ (AssemblyAttributes.fs, AssemblyInfo.fs), and only
           some of them say so in a header. Anything under the intermediate folder is the build's own. A
           generated file elsewhere is caught by its <auto-generated> header, which Curb reads before
           Fantomas ever sees the file. -->
      <_CurbFSharpSource Include="@(Compile->'%(FullPath)')"
                         Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_CurbFSharpIntermediate)'))" />

      <!--
        What decides the output besides the sources, so a change to any of it re-runs the target:
        every .editorconfig above the project and beside each source, the manifests that can pin Fantomas,
        and the .fantomasignore files that can exclude a source. @(EditorConfigFiles) is empty in an
        .fsproj, which is why the chain is found here. Walked a fixed number of levels and filtered to what
        exists: a file listed that does not matter costs a re-run when it changes, never a missed one.
      -->
      <_CurbFSharpLevel Include="." />
      <_CurbFSharpLevel Include=".." />
      <_CurbFSharpLevel Include="../.." />
      <_CurbFSharpLevel Include="../../.." />
      <_CurbFSharpLevel Include="../../../.." />
      <_CurbFSharpLevel Include="../../../../.." />
      <_CurbFSharpLevel Include="../../../../../.." />
      <_CurbFSharpLevel Include="../../../../../../.." />
      <_CurbFSharpLevel Include="../../../../../../../.." />
      <_CurbFSharpLevel Include="../../../../../../../../.." />
      <_CurbFSharpLevel Include="../../../../../../../../../.." />
      <_CurbFSharpLevel Include="../../../../../../../../../../.." />
      <_CurbFSharpCandidate Include="@(_CurbFSharpLevel->'$(MSBuildProjectDirectory)/%(Identity)/.editorconfig')" />
      <_CurbFSharpCandidate Include="@(_CurbFSharpLevel->'$(MSBuildProjectDirectory)/%(Identity)/.fantomasignore')" />
      <_CurbFSharpCandidate Include="@(_CurbFSharpLevel->'$(MSBuildProjectDirectory)/%(Identity)/dotnet-tools.json')" />
      <_CurbFSharpCandidate Include="@(_CurbFSharpLevel->'$(MSBuildProjectDirectory)/%(Identity)/.config/dotnet-tools.json')" />
      <_CurbFSharpCandidate Include="@(_CurbFSharpSource->'%(RootDir)%(Directory).editorconfig')" />
      <_CurbFSharpCandidate Include="@(_CurbFSharpSource->'%(RootDir)%(Directory).fantomasignore')" />
      <_CurbFSharpExisting Include="@(_CurbFSharpCandidate->'%(FullPath)')" Condition="Exists('%(FullPath)')" />
      <_CurbFSharpConfiguration Include="@(_CurbFSharpExisting->Distinct())" />
    </ItemGroup>
  </Target>

  <Target Name="CurbFSharp"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_CurbFSharpPrepare"
          Inputs="@(_CurbFSharpSource);@(_CurbFSharpConfiguration);$(MSBuildProjectFullPath)"
          Outputs="$(Curb_FSharpStampFile)"
          Condition="'$(Curb_Bypass)' != 'true'
                     and '$(Curb_FSharp)' != 'false'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'
                     and '$(Language)' == 'F#'
                     and '@(Compile)' != ''">

    <!-- The same two layers of incrementality as the C# target, for the same reasons: this target's
         Inputs and Outputs first, so an untouched project starts nothing at all, then the cache, so a run
         caused by one edited file sends Fantomas that file and no other. One Fantomas daemon per run. -->

    <PropertyGroup>
      <_CurbFSharpCommand>format</_CurbFSharpCommand>
      <_CurbFSharpCommand Condition="'$(Curb_Check)' == 'true'">check</_CurbFSharpCommand>
    </PropertyGroup>

    <WriteLinesToFile File="$(Curb_FSharpFileList)"
                      Lines="@(_CurbFSharpSource)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <PropertyGroup>
      <_CurbFSharpInvocation Condition="'$(Curb_Exe)' != ''">&quot;$(Curb_Exe)&quot;</_CurbFSharpInvocation>
      <_CurbFSharpInvocation Condition="'$(Curb_Exe)' == ''">&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(Curb_Dll)&quot;</_CurbFSharpInvocation>
      <_CurbFSharpCacheArg Condition="'$(Curb_Cache)' != 'false' and '$(Curb_CacheFile)' != ''">--cache &quot;$(Curb_CacheFile)&quot;</_CurbFSharpCacheArg>
      <_CurbFSharpUnformattedArg Condition="'$(_CurbFSharpCommand)' == 'check'">--unformatted-list-file &quot;$(Curb_UnformattedFile)&quot;</_CurbFSharpUnformattedArg>
    </PropertyGroup>

    <!-- Standard error at high importance: when Fantomas is not restored, or is not the version the
         manifest pins, the line that says so is the only useful part of the failure. -->
    <Exec Command="$(_CurbFSharpInvocation) $(_CurbFSharpCommand) --language fsharp --msbuild-list-file &quot;$(Curb_FSharpFileList)&quot; $(_CurbFSharpCacheArg) $(_CurbFSharpUnformattedArg)"
          StandardOutputImportance="$(Curb_LogLevel)"
          StandardErrorImportance="high"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_CurbFSharpExitCode" />
    </Exec>

    <ReadLinesFromFile File="$(Curb_UnformattedFile)" Condition="'$(_CurbFSharpExitCode)' == '1' and Exists('$(Curb_UnformattedFile)')">
      <Output TaskParameter="Lines" ItemName="_CurbFSharpUnformattedFiles" />
    </ReadLinesFromFile>

    <Warning Condition="'$(_CurbFSharpExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' == 'true' and '@(_CurbFSharpUnformattedFiles)' != ''"
             Code="CURB0001"
             File="%(_CurbFSharpUnformattedFiles.Identity)"
             Text="This file is not formatted. Run 'curb format'." />

    <Error Condition="'$(_CurbFSharpExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' != 'true' and '@(_CurbFSharpUnformattedFiles)' != ''"
           Code="CURB0001"
           File="%(_CurbFSharpUnformattedFiles.Identity)"
           Text="This file is not formatted. Run 'curb format'." />

    <Warning Condition="'$(_CurbFSharpExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' == 'true' and '@(_CurbFSharpUnformattedFiles)' == ''"
             Code="CURB0001"
             Text="Some files are not formatted. Run 'curb format', or build without Curb_Check=true." />

    <Error Condition="'$(_CurbFSharpExitCode)' == '1' and '$(Curb_UnformattedAsWarnings)' != 'true' and '@(_CurbFSharpUnformattedFiles)' == ''"
           Code="CURB0001"
           Text="Some files are not formatted. Run 'curb format', or build without Curb_Check=true." />

    <Error Condition="'$(_CurbFSharpExitCode)' != '0' and '$(_CurbFSharpExitCode)' != '1'"
           Code="CURB0002"
           Text="Curb failed with exit code $(_CurbFSharpExitCode) formatting F#. If Fantomas is not restored, run 'dotnet tool restore'." />

    <Touch Condition="'$(_CurbFSharpExitCode)' == '0'" Files="$(Curb_FSharpStampFile)" AlwaysCreate="true" />

    <ItemGroup>
      <FileWrites Include="$(Curb_FSharpStampFile);$(Curb_FSharpFileList);$(Curb_CacheFile);$(Curb_UnformattedFile)" />
    </ItemGroup>
  </Target>

</Project>
