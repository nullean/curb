<Project>

  <!--
    Imported before the project file, so everything here can be overridden by the project itself.
    The .targets file holds the defaults that must win over a project's own settings; this holds the
    ones a project is expected to change.
  -->

  <PropertyGroup>
    <!-- Set to true to leave the build entirely alone: no process start, no stamp, nothing. -->
    <Curb_Bypass Condition="'$(Curb_Bypass)' == ''"></Curb_Bypass>
  </PropertyGroup>

</Project>
