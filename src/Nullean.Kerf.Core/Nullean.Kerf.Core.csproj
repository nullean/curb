<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nullean.Kerf</RootNamespace>
    <Description>The Kerf C# formatting engine: document IR, layout printer and syntax printers. No IO, no configuration source — bring your own options.</Description>
    <PackageTags>csharp;formatter;editorconfig;ide0055;code-style;prettier</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Roslyn's CommonCompiler.GetAssemblyLocation reads Assembly.Location, which is empty in a
         single-file/AOT app. That lives on the command-line compiler path, which Kerf never invokes:
         we only ever call CSharpSyntaxTree.ParseText. Suppressed deliberately and narrowly. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullean.Kerf.Tests" PublicKey="" />
    <InternalsVisibleTo Include="Nullean.Kerf.Benchmarks" PublicKey="" />
    <InternalsVisibleTo Include="Nullean.Kerf.EditorConfig" PublicKey="" />
  </ItemGroup>

</Project>
