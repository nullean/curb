<Project>

  <!--
    Kerf runs before the compiler, not after it.

    The point of this ordering is EnforceCodeStyleInBuild. With that property set, the IDE analysers
    run inside CoreCompile and report IDE0055 and the code style rules as build diagnostics. A target
    at BeforeTargets="CoreCompile" has already rewritten the files by then, so the compiler reads
    formatted source and the only style diagnostics left are the ones that genuinely need a
    compilation to decide. Someone — or something — building the project gets the mechanical
    offences fixed underneath them and only has to think about the semantic remainder.

    Running after the build, or as a separate command someone has to remember, would not do that.
  -->

  <PropertyGroup>
    <!-- Check rather than rewrite. Defaults to rewriting in Debug and checking in Release: a
         developer wants their file fixed, and a release or CI build wants to be told, not edited. -->
    <Kerf_Check Condition="'$(Kerf_Check)' == '' and '$(Configuration)' == 'Release'">true</Kerf_Check>
    <Kerf_Check Condition="'$(Kerf_Check)' == ''">false</Kerf_Check>

    <!-- The escape hatch. One property, honoured everywhere, so a build that must not be touched
         has a single thing to set. -->
    <Kerf_Bypass Condition="'$(Kerf_Bypass)' == ''">false</Kerf_Bypass>

    <!-- Report unformatted files as warnings rather than errors. Off, because a check that does not
         fail the build is a check nobody notices. -->
    <Kerf_UnformattedAsWarnings Condition="'$(Kerf_UnformattedAsWarnings)' == ''">false</Kerf_UnformattedAsWarnings>

    <!-- MSBuild message importance for Kerf's own output: high, normal or low. Low by default, so
         a successful format is invisible at normal verbosity and the one-line summary is there when
         someone asks for it. Errors and warnings are raised as diagnostics regardless. -->
    <Kerf_LogLevel Condition="'$(Kerf_LogLevel)' == ''">low</Kerf_LogLevel>

  </PropertyGroup>

  <Target Name="KerfPrepare">
    <!--
      Both of these are resolved here rather than in the PropertyGroup above, because that is
      evaluated when this file is imported and $(IntermediateOutputPath) is not set until the SDK's
      own targets have been. Setting the stamp path up there left `kerf.stamp` and `kerf.files` in
      the project directory next to somebody's source — which a build tool has no business doing, and
      which was invisible until one of them was committed.

      A target's Inputs and Outputs are evaluated after its DependsOnTargets have run, so setting the
      stamp path here is early enough for incrementality to use it.
    -->
    <PropertyGroup>
      <Kerf_StampFile Condition="'$(Kerf_StampFile)' == ''">$(IntermediateOutputPath)kerf.stamp</Kerf_StampFile>
      <Kerf_FileList Condition="'$(Kerf_FileList)' == ''">$(IntermediateOutputPath)kerf.files</Kerf_FileList>

      <!-- The framework-dependent build that ships in this package, run on the SDK doing the build.
           See the package project for why this is not a per-RID native binary. Kerf_Exe overrides it
           with a native one, which starts in about a hundredth of the time. -->
      <Kerf_Dll Condition="'$(Kerf_Dll)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/Nullean.Kerf.Cli.dll</Kerf_Dll>
    </PropertyGroup>
  </Target>

  <Target Name="Kerf"
          BeforeTargets="CoreCompile"
          DependsOnTargets="KerfPrepare"
          Inputs="@(Compile);@(EditorConfigFiles);$(MSBuildProjectFullPath)"
          Outputs="$(Kerf_StampFile)"
          Condition="'$(Kerf_Bypass)' != 'true'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'
                     and '@(Compile)' != ''">

    <!--
      Incrementality is by Inputs/Outputs against the compile set and the .editorconfig files that
      govern it, so an untouched project pays nothing at all — no process start, no directory walk.
      A formatter that re-scans every file on every build gets a formatting cache bolted on to hide
      the cost; not needing one is better than having a fast one.

      The project file is an input because changing it can change which files are compiled.
    -->

    <PropertyGroup>
      <_KerfCommand>format</_KerfCommand>
      <_KerfCommand Condition="'$(Kerf_Check)' == 'true'">check</_KerfCommand>
    </PropertyGroup>

    <!-- Only the files this project actually compiles. Passing the folder would reach sources that
         belong to another project, or to none. -->
    <WriteLinesToFile File="$(Kerf_FileList)"
                      Lines="@(Compile->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <PropertyGroup>
      <_KerfInvocation Condition="'$(Kerf_Exe)' != ''">&quot;$(Kerf_Exe)&quot;</_KerfInvocation>
      <_KerfInvocation Condition="'$(Kerf_Exe)' == ''">&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(Kerf_Dll)&quot;</_KerfInvocation>
    </PropertyGroup>

    <Exec Command="$(_KerfInvocation) $(_KerfCommand) --files &quot;$(Kerf_FileList)&quot;"
          StandardOutputImportance="$(Kerf_LogLevel)"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_KerfExitCode" />
    </Exec>

    <!-- Exit 1 is "some files are not formatted", which only `check` can produce. Anything else
         non-zero is Kerf failing, and that is an error whatever the warnings setting says: a
         formatter that could not run has verified nothing, and saying so quietly would be worse
         than not running at all. -->
    <Warning Condition="'$(_KerfExitCode)' == '1' and '$(Kerf_UnformattedAsWarnings)' == 'true'"
             Code="KERF0001"
             Text="Some files are not formatted. Run 'kerf format', or build without Kerf_Check=true." />

    <Error Condition="'$(_KerfExitCode)' == '1' and '$(Kerf_UnformattedAsWarnings)' != 'true'"
           Code="KERF0001"
           Text="Some files are not formatted. Run 'kerf format', or build without Kerf_Check=true." />

    <Error Condition="'$(_KerfExitCode)' != '0' and '$(_KerfExitCode)' != '1'"
           Code="KERF0002"
           Text="Kerf failed with exit code $(_KerfExitCode)." />

    <!-- Only stamp a clean run. Stamping after a failure would make the next build skip the target
         and look like it passed. -->
    <Touch Condition="'$(_KerfExitCode)' == '0'" Files="$(Kerf_StampFile)" AlwaysCreate="true" />

    <ItemGroup>
      <FileWrites Include="$(Kerf_StampFile);$(Kerf_FileList)" />
    </ItemGroup>
  </Target>

</Project>
