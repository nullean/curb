<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Nullean.Make.Fs reads the target descriptions from the /// comments on the Target cases in CommandLine.fs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Nullean.Make.Fs" />
    <PackageReference Include="Proc.Fs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Paths.fs" />
    <Compile Include="CommandLine.fs" />
    <Compile Include="Documentation.fs" />
    <Compile Include="Targets.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
