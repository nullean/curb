<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The F# half of the MSBuild smoke test: Curb hands an F# project's own sources to the Fantomas its tool
    manifest pins, before the compiler reads them.

    Program.fs is restored from Program.unformatted before each build, so it always needs formatting;
    Stable.fs is already formatted and stays so, which is what lets the harness assert that a second run
    served exactly one file from the cache. The manifest beside this file pins Fantomas, and it is a root
    manifest so the repository's own tools are not consulted.

    Excluded from the solution build; driven by ./build.sh fsharpsmoketest, which restores the tool, points
    Curb_Exe at the freshly published binary, and checks both directions: with Curb the file comes out
    formatted, and with Curb bypassed it does not.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.props" />

  <ItemGroup>
    <Compile Include="Stable.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.targets" />

</Project>
