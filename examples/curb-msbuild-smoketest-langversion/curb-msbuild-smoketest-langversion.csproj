<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves Curb never writes syntax a project's C# version cannot compile (issue #298). The
    .editorconfig asks for file-scoped namespaces, which need C# 10, and expression-bodied methods,
    which need C# 6. netstandard2.0 compiles as C# 7.3 by default and net11.0 as C# 15, so the build
    only succeeds if Curb applied the lowest of the two: the method gains its arrow and the namespace
    keeps its braces.

    Excluded from the solution build; driven by ./build.sh msbuildsmoketest, which points Curb_Exe at
    the freshly published binary.
  -->

  <PropertyGroup>
    <!-- The repository's Directory.Build.props sets TargetFramework, which would make this a
         single-targeting project, and LangVersion to latest. Both cleared, so each framework compiles
         at the default it implies, which is the case the issue is about. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net11.0;netstandard2.0</TargetFrameworks>
    <LangVersion></LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.props" />

  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.targets" />

</Project>
