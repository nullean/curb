<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves the claim the MSBuild integration is built on: Curb runs early enough that
    EnforceCodeStyleInBuild has nothing left to report. The source next to this file is deliberately
    misformatted, IDE0055 is escalated to an error, and the build is expected to succeed — which it
    only can if Curb rewrote the file before CoreCompile read it.

    Excluded from the solution build; driven by ./build.sh msbuild-smoketest, which points Curb_Exe
    at the freshly published binary.

    Stable.cs is the second half of that: it is already formatted and stays so, which is what lets the
    harness assert that the second build served exactly one file from the cache while Program.cs, which
    it restores to its misformatted state each time, still misses.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- The package imports props before the project and targets after it, so the sample does the
       same rather than importing both at the top and testing an arrangement no consumer has. -->
  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.props" />

  <Import Project="../../src/Nullean.Curb.MSBuild/build/curb.targets" />

</Project>
