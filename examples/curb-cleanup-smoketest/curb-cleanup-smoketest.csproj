<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves the claim `curb cleanup` is built on: the compiler's own diagnostics are enough to fix the
    semantic code style rules Curb cannot decide from syntax.

    Four assertions rather than two, driven by ./build.sh cleanupsmoketest. The existing MSBuild smoke
    test needs two because that is what proving a formatter takes; cleanup can be wrong in two more ways,
    so it needs two more:

      1. The build fails, because IDE0005 is escalated to an error and nothing has fixed it yet.
      2. `curb cleanup` reads the log that failing build wrote, and the source changes.
      3. The next build succeeds with no IDE0005 in its output at all — fixed, not silenced. Curb never
         writes a severity, and this is what would catch it if it did.
      4. With the severity line removed, cleanup leaves the source byte-identical. Turning this on for a
         repository that asked for nothing has to change nothing.

    Note that assertion 1 is also why cleanup cannot be an MSBuild target: the compiler writes its error
    log even when it fails, but a target at AfterTargets="Build" never runs, so the configuration where
    cleanup is most wanted is the one where a post-build hook is unreachable.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 is not reported without it: without a documentation file the parser runs in a mode that
         cannot see a cref, so Roslyn declines to call a directive unnecessary rather than risk being
         wrong about one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The package imports props before the project and targets after it, so the sample does the same
       rather than testing an arrangement no consumer has. The targets are what set $(ErrorLog). -->
  <Import Project="../../src/Nullean.Curb.MSBuild/build/Nullean.Curb.MSBuild.props" />

  <Import Project="../../src/Nullean.Curb.MSBuild/build/Nullean.Curb.MSBuild.targets" />

</Project>
