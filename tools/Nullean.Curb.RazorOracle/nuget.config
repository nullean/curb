<?xml version="1.0" encoding="utf-8"?>
<!--
  The Razor oracle's own package sources, apart from the repository's. Microsoft.CodeAnalysis.Razor.DotNetFormat,
  the engine `dotnet format` is getting for Razor (dotnet/sdk#56563), is published only to Microsoft's public
  dnceng feed for now. Nothing that ships references this project, and this file keeps that feed away from
  every project that does.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.Razor.*" />
      <package pattern="Microsoft.AspNetCore.Razor.*" />
      <package pattern="Microsoft.CodeAnalysis*" />
      <package pattern="Microsoft.NET.Sdk.Razor.SourceGenerators*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
