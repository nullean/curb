<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only: runs Microsoft's Razor formatter over Curb's Razor expectations, the way verifyexpectations runs
    `dotnet format` over its C# ones. Never packed, never referenced, not in curb.slnx. It pins its own prerelease
    Roslyn (the Razor engine requires it), which is why it stays a separate process rather than a reference.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);RS1038;RSEXPERIMENTAL004;NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Razor.DotNetFormat" Version="11.2.0-preview.26553.101" />
  </ItemGroup>

</Project>
